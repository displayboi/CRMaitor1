datasource db {
  provider = "postgresql" // Cambiar el proveedor a MySQL
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  citas    citas[] // Relación 1:N con la tabla citas
}

model citas {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @db.Date
  texto      String   @db.VarChar(500)
  userId     Int
  username   String   // Nuevo campo para el nombre de usuario
  telefono   String   // Nuevo campo para el teléfono móvil
  user       User     @relation(fields: [userId], references: [id]) // Relación con la tabla User
}
